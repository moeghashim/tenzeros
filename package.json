{
  "name": "tenzeros",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "pnpm start",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:screenshots": "tsx scripts/screenshot-onboarding.ts",
    "test:e2e": "playwright test",
    "verify:real": "tsx scripts/verify-real-flows.ts",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@tabler/icons-vue": "^3.36.1",
    "better-sqlite3": "^12.4.1",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.44.7",
    "h3": "^1.15.4",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.2.0",
    "marked": "^18.1.1",
    "motion-v": "^2.8.0",
    "nuxt": "^4.0.0",
    "openai": "^6.0.0",
    "papaparse": "^5.7.0",
    "sanitize-html": "^2.18.1",
    "simple-icons": "^11.15.0",
    "vue": "~3.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.5",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
