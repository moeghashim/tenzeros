{
  "name": "tenzeros",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "node --env-file=.env .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@tabler/icons-vue": "^3.36.1",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.7",
    "h3": "^1.15.4",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.2.0",
    "nuxt": "^4.0.0",
    "openai": "^6.0.0",
    "vue": "~3.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  },
  "pnpm": { "onlyBuiltDependencies": ["better-sqlite3", "esbuild"] }
}
