# Copy to .env. Never commit your real key or session secret.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_MOCK=0

# Local development default only. Replace with at least 32 random characters
# for deployment (e.g. openssl rand -hex 32). Production rejects this default.
NUXT_SESSION_SECRET=tenzeros-local-development-secret-change-before-deploying

# Optional: set both for real Google OAuth. Otherwise use Demo simulation.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional persistent SQLite location (default: .data/tenzeros.db).
# DATABASE_PATH=.data/tenzeros.db
